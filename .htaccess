# ===== Pekon Padang Cermin — root .htaccess (deploy Apache/cPanel) =====
# Berlaku bila docroot mengarah ke folder project ini.
# Server dev lokal (php -S) TIDAK membaca file ini.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (A02 Cryptographic Failures)
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Blokir akses langsung ke area sensitif (A05 Security Misconfiguration)
    RewriteRule ^(config|function|view|Zzz|docs|@agents)/ - [F,L]
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^(AGENTS|ARSITEKTUR|DESIGN|README)\.md$ - [F,L]
    RewriteRule ^\.(git|codebase-memory|rtk|opencode)(/.*)?$ - [F,L]

    # Root "/" harus masuk ke front controller public/index.php.
    # (Folder root tidak punya DirectoryIndex — tanpa aturan ini "/" jadi 403.)
    RewriteRule ^$ public/index.php [L]

    # Request lain dialihkan ke public/ — kecuali file/folder nyata
    # (mis. uploads/) supaya gambar tetap bisa diakses langsung.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Hapus header versi server (A05)
<IfModule mod_headers.c>
    Header unset X-Powered-By
</IfModule>
